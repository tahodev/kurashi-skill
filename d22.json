aphStyle":{"direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true,"namedStyleType":"NORMAL_TEXT","pageBreakBefore":false,"spaceAbove":{"magnitude":12,"unit":"PT"},"spaceBelow":{"magnitude":4,"unit":"PT"}},"textStyle":{"fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"color":{"rgbColor":{"blue":0.4,"green":0.4,"red":0.4}}},"italic":true}},{"namedStyleType":"TITLE","paragraphStyle":{"direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true,"namedStyleType":"NORMAL_TEXT","pageBreakBefore":false,"spaceAbove":{"unit":"PT"},"spaceBelow":{"magnitude":3,"unit":"PT"}},"textStyle":{"fontSize":{"magnitude":26,"unit":"PT"}}},{"namedStyleType":"SUBTITLE","paragraphStyle":{"direction":"LEFT_TO_RIGHT","keepLinesTogether":true,"keepWithNext":true,"namedStyleType":"NORMAL_TEXT","pageBreakBefore":false,"spaceAbove":{"unit":"PT"},"spaceBelow":{"magnitude":16,"unit":"PT"}},"textStyle":{"fontSize":{"magnitude":15,"unit":"PT"},"foregroundColor":{"color":{"rgbColor":{"blue":0.4,"green":0.4,"red":0.4}}},"italic":false,"weightedFontFamily":{"fontFamily":"Arial","weight":400}}}]}},"tabProperties":{"index":1,"tabId":"t.g3fsjrcz3y","title":"v1 초고"}},{"documentTab":{"body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"endIndex":66,"paragraph":{"elements":[{"endIndex":66,"startIndex":1,"textRun":{"content":"# (번역본) 3週間目の正直な振り返り。21スキル、52コミット、そして初PR3本【kurashi-skill Day 22】\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1},{"endIndex":67,"paragraph":{"elements":[{"endIndex":67,"startIndex":66,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":66},{"endIndex":163,"paragraph":{"elements":[{"endIndex":163,"startIndex":67,"textRun":{"content":"지난 회고(Day 15)에서 「18스킬, 37커밋, 별 2개」라고 썼다. 그로부터 1주일, 매일의 발행은 멈추지 않았다. 3주가 지났으므로, 다시 정직한 숫자를 나열한다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":67},{"endIndex":164,"paragraph":{"elements":[{"endIndex":164,"startIndex":163,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":163},{"endIndex":179,"paragraph":{"elements":[{"endIndex":179,"startIndex":164,"textRun":{"content":"## 기: 이번 주의 숫자\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":164},{"endIndex":180,"paragraph":{"elements":[{"endIndex":180,"startIndex":179,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":179},{"endIndex":288,"paragraph":{"elements":[{"endIndex":288,"startIndex":180,"textRun":{"content":"2026-09-28 시점 실측: 스킬은 21개, main으로의 커밋은 52, GitHub 별은 3, 포크는 2. Qiita 기사는 시리즈 18편(전체 20편), 좋아요 합계는 9, 스톡은 5.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":180},{"endIndex":289,"paragraph":{"elements":[{"endIndex":289,"startIndex":288,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":288},{"endIndex":397,"paragraph":{"elements":[{"endIndex":397,"startIndex":289,"textRun":{"content":"지난번보다 스킬이 3개, 커밋이 15, 별이 1개 늘었다. 솔직히 말하면, 숫자는 아직 작다. 좋아요 합계가 두 자리에 못 미친다. 매일 쓰는 사람으로서는 조금 더 튀었으면 하는 마음도 있다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":289},{"endIndex":398,"paragraph":{"elements":[{"endIndex":398,"startIndex":397,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":397},{"endIndex":426,"paragraph":{"elements":[{"endIndex":426,"startIndex":398,"textRun":{"content":"## 승: 하지만 숫자에 안 나오는 일이 일어났다\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":398},{"endIndex":427,"paragraph":{"elements":[{"endIndex":427,"startIndex":426,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":426},{"endIndex":649,"paragraph":{"elements":[{"endIndex":649,"startIndex":427,"textRun":{"content":"이번 주 가장 컸던 것은 숫자의 늘어남이 아니다. 모르는 사람에게서 풀 리퀘스트가 온 것이다. @mangomac 이라는 사람이 3건이나 보내줬다. README 표 중간에 끼어 있던 문단의 수정, 피난소 스킬의 캐시가 7일 이상 오래됐을 때 경고를 내는 개선, 그리고 피난소 좌표에 nan이나 범위 밖 값이 섞였을 때의 제외 처리. 어느 것이든, 내가 알아차리지 못했던 곳에 효과가 있는 것들이다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":427},{"endIndex":650,"paragraph":{"elements":[{"endIndex":650,"startIndex":649,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":649},{"endIndex":796,"paragraph":{"elements":[{"endIndex":796,"startIndex":650,"textRun":{"content":"게다가 3건 모두, lint와 CI와 회귀 테스트를 통과한 상태로 왔다. 즉 이 사람은 CONTRIBUTING을 읽고, 테스트 작성법에 맞추고, CI가 통과함을 확인하고 나서 보냈다. 내가 「올지도 모르는 누군가」를 위해 써두었던 정비를, 그대로 써준 것이다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":650},{"endIndex":797,"paragraph":{"elements":[{"endIndex":797,"startIndex":796,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":796},{"endIndex":826,"paragraph":{"elements":[{"endIndex":826,"startIndex":797,"textRun":{"content":"## 전: 정비는 미래의 누군가에게 보내는 편지였다\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":797},{"endIndex":827,"paragraph":{"elements":[{"endIndex":827,"startIndex":826,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":826},{"endIndex":948,"paragraph":{"elements":[{"endIndex":948,"startIndex":827,"textRun":{"content":"솔직히 말하면, 문서나 CI는 매일의 기사 쓰기 중에서 가장 수수한 작업이었다. 실측일 헤더 통일, URL 컨트랙트, 90일 신선도 체크. 쓰는 동안은 「이거, 누가 이득 보는 거지」라고 생각하지 않은 것도 아니다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":827},{"endIndex":949,"paragraph":{"elements":[{"endIndex":949,"startIndex":948,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":948},{"endIndex":1125,"paragraph":{"elements":[{"endIndex":1125,"startIndex":949,"textRun":{"content":"답은 두 개였고, 하나는 이번 주에 온 누군가. 또 하나는 미래의 나였다. 이번 주 중반, 내가 심어둔 health-check가 나 자신의 실수(새 스킬 3개를 README 표에 싣는 것을 잊은)를 검출해서 이슈를 세웠다. 내가 쳐둔 그물에 내가 걸린다. 조금 어리석지만, 그물이 작동하고 있다는 증거이기도 하다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":949},{"endIndex":1126,"paragraph":{"elements":[{"endIndex":1126,"startIndex":1125,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1125},{"endIndex":1143,"paragraph":{"elements":[{"endIndex":1143,"startIndex":1126,"textRun":{"content":"## 결: 남은 8일에 할 일\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1126},{"endIndex":1144,"paragraph":{"elements":[{"endIndex":1144,"startIndex":1143,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1143},{"endIndex":1328,"paragraph":{"elements":[{"endIndex":1328,"startIndex":1144,"textRun":{"content":"30일 챌린지는 앞으로 8일. 할 일은 변하지 않는다. 로드맵에 남은 생활의 테마를 하루 1편, 실측을 잡고, 스킬과 기사를 낸다. 30일로 「완성」이 되지는 않고, 거기서부터는 보수의 나날이 시작된다. 공개 데이터는 살아있는 것이라, URL은 죽고 CSV 형식은 바뀐다. 실측일과 CI가 있는 것은 그 나날을 돌리기 위해서다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1144},{"endIndex":1329,"paragraph":{"elements":[{"endIndex":1329,"startIndex":1328,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1328},{"endIndex":1345,"paragraph":{"elements":[{"endIndex":1345,"startIndex":1329,"textRun":{"content":"오늘의 가져갈 것은 3가지.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1329},{"endIndex":1346,"paragraph":{"elements":[{"endIndex":1346,"startIndex":1345,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1345},{"endIndex":1425,"paragraph":{"elements":[{"endIndex":1425,"startIndex":1346,"textRun":{"content":"1. **숫자는 작은 채로 괜찮다.** 먼저 늘어나는 것은 숫자 이외의 것 — 쓰는 버릇, 정비의 정도, 그리고 누군가와의 접점 — 쪽이다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1346},{"endIndex":1505,"paragraph":{"elements":[{"endIndex":1505,"startIndex":1425,"textRun":{"content":"2. **README와 CI는 미래의 누군가에게 보내는 편지.** 누군가는 실제로 온다. 왔을 때 헤매지 않게 하는 정비는 쓴 만큼 돌아온다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1425},{"endIndex":1577,"paragraph":{"elements":[{"endIndex":1577,"startIndex":1505,"textRun":{"content":"3. **내 CI는 나를 잡는다.** 그래도 된다. 그물이 작동한다는 것은 누군가가 길을 잃기 전에 알아차릴 수 있다는 것이다.\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1505},{"endIndex":1578,"paragraph":{"elements":[{"endIndex":1578,"startIndex":1577,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1577},{"endIndex":1655,"paragraph":{"elements":[{"endIndex":1655,"startIndex":1578,"textRun":{"content":"kurashi-skill은 공개 개발 중. 리포지토리는 여기 → https://github.com/tahodev/kurashi-skill\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1578},{"endIndex":1656,"paragraph":{"elements":[{"endIndex":1656,"startIndex":1655,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"direction":"LEFT_TO_RIGHT","namedStyleType":"NORMAL_TEXT"}},"startIndex":1655}]},"documentStyle":{"background":{"color":{}},"documentFormat":{"documentMode":"PAGES"},"marginBottom":{"magnitude":72,"unit":"PT"},"marginFooter":{"magnitude":36,"unit":"PT"},"marginHeader":{"magnitude":36,"unit":"PT"},"marginLeft":{"magnitude":72,"unit":"PT"},"marginRight":{"magnitude":72,"unit":"PT"},"marginTop":{"magnitude":72,"unit":"PT"},"pageNumberStart":1,"pageSize":{"height":{"magnitude":841.8897637795277,"unit":"PT"},"width":{"magnitude":595.2755905511812,"unit":"PT"}},"useCustomHeaderFooterMargins":true},"namedStyles":{"styles":[{"namedStyleType":"NORMAL_TEXT","paragraphStyle":{"alignment":"START","avoidWidowAndOrphan":true,"borderBetween":{"color":{},"dashStyle":"SOLID","padding":{"unit":"PT"},"width":{"unit":"PT"}},"borderBottom":{"color":{},"dashStyle":"SOLID","padding":{"unit":"PT"},"width":{"unit":"PT"}},"borderLeft":{"color":{},"dashStyle":"SOLID","padding":{"unit":"PT"},"width":{"unit":"PT"}},"borderRight":{"color":{},"dashStyle":"SOLID","padding":{"unit":"PT"},"width":{"unit":"PT"}},"borderTop":{"color":{},"dashStyle":"SOLID","padding":{"unit":"PT"},"width":{"unit":"PT"}},"direction":"LEFT_TO_RIGHT","indentEnd":{"unit":"PT"},"indentFirstLine":{"unit":"PT"},"indentStart":{"unit":"PT"},"keepLinesTogether":false,"keepWithNext":false,"lineSpacing":115,"namedStyleType":"NORMAL_TEXT","pageBreakBefore":false,"shading":{"backgroundColor":{}},"spaceAbove":{"unit":"PT"},"spaceBelow":{"unit":"PT"},"spacingMode":"COLLAPSE_LISTS"},"textStyle":{"backgroundColor":{},"baselineOffset":"NONE","bold":false,"fontSize":{"magnitude":11,"unit":"PT"},"foregroundColor":{"color":{"rgbColor":{}}},"italic":false,"smallCaps":false,"strikethrough":fals